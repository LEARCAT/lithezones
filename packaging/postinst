#!/bin/sh
set -e

# 0.5.49：安装后主动检查面板运行依赖。管理面板是 Tk 程序，需要 python3
# 与 python3-tk；部分 deepin 精简镜像不带 python3-tk，所以 control 不再把它列为
# 硬依赖（否则 dpkg 在依赖阶段直接失败，这段提示根本没机会显示）。
# 包内 vendor 的 Pillow 是 cp312 ABI，必须用 3.12 的解释器。
# 缺失时只给出清晰提示（不 exit 非 0，否则 dpkg 会回滚整个安装）。
_MISSING=""
if ! command -v wmctrl >/dev/null 2>&1; then
    _MISSING="$_MISSING wmctrl"
fi
if ! command -v python3 >/dev/null 2>&1; then
    _MISSING="$_MISSING python3"
else
    _PYVER=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo "0.0")
    case "$_PYVER" in
        3.12) ;;
        *)  _MISSING="$_MISSING python3(需 3.12，当前 $_PYVER)" ;;
    esac
    if ! python3 -c 'import tkinter' >/dev/null 2>&1; then
        _MISSING="$_MISSING python3-tk"
    fi
fi
if [ -n "$_MISSING" ]; then
    echo "" >&2
    echo "============================================================" >&2
    echo "  LitheZones 已安装，但缺少面板运行依赖:$_MISSING" >&2
    echo "  托盘和快捷键可用，但「窗口排列 / 管理面板」会打不开。" >&2
    echo "  请在终端执行后重新打开面板：" >&2
    echo "    sudo apt install wmctrl python3 python3-tk" >&2
    echo "  （本机实测 deepin V25 已自带 python3-tk；Pillow 扩展为 cp312 ABI）" >&2
    echo "============================================================" >&2
    echo "" >&2
fi

# 安装后「开机启动」默认不勾选：postinst 不再写入 ~/.config/autostart。
# 已存在的项一律保留（不覆盖、不删除），尊重用户此前的主动开启状态。
# 想要开机启动时，用户在托盘菜单点「开机启动」，由 toggle_autostart 创建。

# 刷新图标主题缓存，让 deepin dock / 启动器立即识别 lithezones 应用图标。
# 某些环境没有 gtk-update-icon-cache，静默跳过即可（SVG/PNG 仍在，重启登录也会重建）。
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
fi

# deepin 的 dock 收藏应用存在 gsettings docked-apps 列表里（desktop ID）。
# 旧版 0.5.39 及以前只调了 V20 兼容 API RequestDock（V25 上是空操作），
# 加上装包后不再默认自启，登录时应用没运行 → dock 没有图标、面板最小化后
# 找不到恢复入口。这里把 lithezones 追加进收藏列表；已有则不动，尊重用户。
# 非 deepin 环境没有这个 schema，set 失败静默跳过。
if command -v gsettings >/dev/null 2>&1; then
    _dock=$(gsettings get com.deepin.dde.dock docked-apps 2>/dev/null) || _dock=""
    case "$_dock" in
        *lithezones*) ;;
        *)
            case "$_dock" in
                *\]*)
                    _new=$(printf '%s' "$_dock" | sed "s/]$/, 'lithezones']/")
                    gsettings set com.deepin.dde.dock docked-apps "$_new" 2>/dev/null || true
                    ;;
            esac
            ;;
    esac
fi

# 安装 / 升级后自动拉起托盘。
# 背景：软件更新走 dpkg 安装时，旧托盘进程可能仍持有旧二进制的 current_exe()，
# 由它拉起的助手会跑旧代码而无法启动新版。把启动动作放进 dpkg 的 postinst，
# 由安装流程直接拉起，不依赖旧进程或助手代码版本，从根本上保证装完就启动。
start_tray() {
    # 1) 确定图形会话用户：sudo 用户 > pkexec 用户 > 有 session bus 的普通用户
    user="${SUDO_USER:-}"
    if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
        user=$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1)
    fi
    if [ -z "$user" ] || [ "$user" = "root" ]; then
        for d in /run/user/[0-9]*; do
            [ -S "$d/bus" ] || continue
            uid=${d##*/}
            [ "$uid" -ge 1000 ] 2>/dev/null || continue
            u=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1)
            if [ -n "$u" ]; then user="$u"; break; fi
        done
    fi
    [ -n "$user" ] || return 0
    [ "$user" != "root" ] || return 0
    uid=$(id -u "$user" 2>/dev/null) || return 0
    runtime="/run/user/$uid"
    [ -S "$runtime/bus" ] || return 0  # 无图形会话（纯命令行安装）则跳过

    # 2) DISPLAY：优先从该用户已有进程继承，取不到就用 :0
    display=""
    for p in $(pgrep -u "$user" 2>/dev/null | head -40); do
        d=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -1)
        if [ -n "$d" ]; then display="$d"; break; fi
    done
    [ -n "$display" ] || display=":0"

    # 3) 幂等：已有实例持有单实例锁就不重复拉起
    if runuser -u "$user" -- env \
        DISPLAY="$display" \
        XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
        dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply \
        /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner \
        string:com.lithezones.app >/dev/null 2>&1; then
        return 0
    fi

    # 4) 以会话用户身份、脱离控制终端后台启动
    runuser -u "$user" -- env \
        DISPLAY="$display" \
        XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
        setsid /usr/bin/lithezones >/dev/null 2>&1 < /dev/null &
    return 0
}

case "$1" in
    configure)
        # 等 prerm 的 pkill 与 D-Bus 锁释放完成
        sleep 1
        start_tray || true
        ;;
esac

echo "轻格分窗已安装，托盘将自动启动。"

exit 0
